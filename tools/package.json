{
  "name": "readme-assets",
  "private": true,
  "description": "Zero-dependency generators for the SVG assets used in the profile README.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build-static.mjs",
    "stats": "node src/stats/index.mjs",
    "stats:placeholder": "node src/stats/index.mjs --placeholder",
    "preview": "node src/stats/index.mjs --fixture test/fixtures/user.json --today 2026-11-04 --exclude 'Jupyter Notebook' --out ../.preview/stats",
    "test": "node --test \"test/*.test.mjs\""
  }
}
